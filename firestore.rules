rules_version = '2';

// Solo voi due potete leggere e scrivere. Chiunque altro (anche se fa
// login con Google) riceve "permesso negato".
// Sostituisci le due email con le vostre, tutto minuscolo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
             'stelioromagnoli1@gmail.com',
             'michelleangrisanii@gmail.com'
           ];
    }

    match /{document=**} {
      allow read, write: if isUs();
    }
  }
}
